<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>net.devstudy</groupId>
		<artifactId>platform-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>vendor/platform-libs/platform-parent/pom.xml</relativePath>
	</parent>

	<groupId>net.devstudy</groupId>
	<artifactId>resume</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>resume-auth-service-parent</name>
	<description>Parent and aggregator for resume-auth-service</description>

	<modules>
				<module>vendor/platform-libs</module>
<module>microservices/backend/services/auth-service</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-banned-dependencies</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>net.devstudy:resume-web</exclude>
										<exclude>net.devstudy:resume-search</exclude>
										<exclude>net.devstudy:resume-auth</exclude>
										<exclude>net.devstudy:resume-profile</exclude>
										<exclude>net.devstudy:resume-notification</exclude>
									</excludes>
									<message>
										Banned domain dependencies detected. Use contracts + platform-shared-auth only for resume-auth-service.
									</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
