<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.devstudy</groupId>
        <artifactId>resume-platform-libs-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>platform-test</artifactId>
    <name>platform-test</name>
    <packaging>jar</packaging>

    <properties>
        <compatibility.skip>true</compatibility.skip>
        <compatibility.referenceVersion>0.0.1-SNAPSHOT</compatibility.referenceVersion>
        <japicmp.version>0.18.5</japicmp.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.devstudy</groupId>
            <artifactId>platform-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.devstudy</groupId>
            <artifactId>platform-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.devstudy</groupId>
            <artifactId>platform-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.devstudy</groupId>
            <artifactId>resume-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>${japicmp.version}</version>
                <executions>
                    <execution>
                        <id>binary-compat-platform-http</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <skip>${compatibility.skip}</skip>
                            <oldVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>platform-http</artifactId>
                                    <version>${compatibility.referenceVersion}</version>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>platform-http</artifactId>
                                    <version>${project.version}</version>
                                </dependency>
                            </newVersion>
                            <parameter>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                            </parameter>
                        </configuration>
                    </execution>
                    <execution>
                        <id>binary-compat-platform-observability</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <skip>${compatibility.skip}</skip>
                            <oldVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>platform-observability</artifactId>
                                    <version>${compatibility.referenceVersion}</version>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>platform-observability</artifactId>
                                    <version>${project.version}</version>
                                </dependency>
                            </newVersion>
                            <parameter>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                            </parameter>
                        </configuration>
                    </execution>
                    <execution>
                        <id>binary-compat-platform-security</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <skip>${compatibility.skip}</skip>
                            <oldVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>platform-security</artifactId>
                                    <version>${compatibility.referenceVersion}</version>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>platform-security</artifactId>
                                    <version>${project.version}</version>
                                </dependency>
                            </newVersion>
                            <parameter>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                            </parameter>
                        </configuration>
                    </execution>
                    <execution>
                        <id>binary-compat-resume-shared</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <skip>${compatibility.skip}</skip>
                            <oldVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>resume-shared</artifactId>
                                    <version>${compatibility.referenceVersion}</version>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <dependency>
                                    <groupId>net.devstudy</groupId>
                                    <artifactId>resume-shared</artifactId>
                                    <version>${project.version}</version>
                                </dependency>
                            </newVersion>
                            <parameter>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingClasses>true</ignoreMissingClasses>
                            </parameter>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
